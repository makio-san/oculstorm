{
  "issue": 24,
  "title": "Real-time like solar wind noise augmentation in training",
  "date": "2026-11-25",
  "horizon_hours": 1,
  "split": "train 1995-01-01 .. 2017-01-01 (exclusive), validation 2017-01-01 .. 2021-01-01 (exclusive); rows from 2021 onwards dropped from the table before anything was built or fitted, test years not used",
  "option": {
    "function": "oculstorm.augment.perturb_solar_wind(df, level, seed), oculstorm.augment.train_copies(df, level, copies, seed)",
    "recipe_at_level_1": {
      "delay": "per 24 h segment the whole solar wind block is shown 0 or 1 hour late with probability 0.5 (value at t becomes the clean value at t-1, never t+1)",
      "noise": "proton_density and proton_temp times exp(N(0, 0.2)), flow_speed times 1 + N(0, 0.03), N(0, 0.5 nT) added to bz_gsm, by_gsm, b_mag_avg, independent per hour",
      "derived": "flow_pressure scaled with n v^2, electric_field = -v Bz 1e-3; coupling terms follow in build_features and build_windows",
      "dropout": "solar wind block set to NaN in runs of 1 to 3 hours, about 2% of hours"
    },
    "level": "scales the noise widths, the dropout share and the delay probability; 1 is the recipe above, 0.5 half of it",
    "xgboost": "scripts/train_xgb.py --sw-noise-aug LEVEL [--sw-noise-copies K] [--sw-noise-seed S]",
    "gru": "scripts/train_gru.py --sw-noise-aug LEVEL [--sw-noise-copies K] [--sw-noise-seed S]; copies are scaled with the clean training statistics",
    "used_here": "one perturbed copy of the training years (copy seed 0) appended to the clean training years; early stopping on the clean validation years",
    "default": "off (level 0); defaults leave features, windows and fits unchanged (tests/test_augment.py)",
    "leakage_test": "tests/test_augment.py: the shift is 0 or 1 hour late and never early; the perturbed table, features and GRU windows up to hour t do not change when later hours change; copies hold training hours only"
  },
  "baseline": {
    "xgboost": "current configuration (PARAMS, 6 lags) refitted in this run with the table cut before 2021; clean validation RMSE 2.6565 equals validation_scores in reports/xgb_baseline.json",
    "gru": "production models models/gru_dst_1h_seed{0,1,2}.pt as on main, not retrained; clean validation RMSE of the 3 seed mean 2.6205 equals validation_scores in reports/gru_baseline.json"
  },
  "evaluation_sets": {
    "clean": "validation years as they are",
    "perturbed_1": "perturb_solar_wind(table before 2021, level 1, seed 2024), validation rows; targets and persistence are the clean Dst",
    "perturbed_0.5": "same with level 0.5, seed 2024"
  },
