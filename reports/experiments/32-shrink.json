{
  "issue": 32,
  "experiment": "shrink the predicted change in quiet conditions: forecast = Dst(t) + alpha * change",
  "horizon_hours": 1,
  "models": "production models/xgb_dst_1h.ubj and the mean of models/gru_dst_1h_seed*.pt, not retrained",
  "data": "validation 2017-01-01 00:00:00 .. 2020-12-31 23:00:00, table cut before 2021-01-01, test years not used",
  "quiet_condition": "dst_lag0 > -30 and dst_min24 > -50 and vbs_mean3 < 0.5, from the inputs as the model saw them at t; a missing vbs_mean3 (solar wind gap) is not quiet; alpha = 1 outside it",
  "alpha": "least squares on the quiet condition hours of the fitting half, clipped to [0, 1]; 1 with fewer than 24 hours",
  "bins": {
    "edge_nt": 2.0,
    "names": [
      "abs change < 2 nT",
      "abs change >= 2 nT"
    ],
    "by": "absolute predicted change"
  },
  "cross_fit": "fit 2017 to 2018 and score 2019 to 2020, then the reverse; scores are on the pooled out of fold hours",
  "inputs": {
    "clean": "validation as it is",
    "perturbed newest Dst hour": "Dst(t) + e(t) as the newest hour of every forecast, e an AR(1) series with mean -3 nT, standard deviation 4 nT, coefficient 0.6, seed 32; earlier hours and the target are clean; the forecast and persistence start from the perturbed value",
    "not_run": "perturbed solar wind: the issue 24 code is not on main"
  },
  "scoring_regimes": "by the observed target Dst, as in oculstorm.metrics.REGIMES, plus the causal quiet condition",
  "bootstrap": {
    "method": "oculstorm.metrics.block_bootstrap_rmse, paired against alpha 1 of the same model",
    "block_hours": 168,
    "resamples": 2000,
    "seed": 0
  },
  "promising_bar": "retrain policy on the pooled out of fold hours: overall MSE at least 2% lower, or storm MSE at least 3% lower with overall at most 1% higher, intervals excluding zero",
